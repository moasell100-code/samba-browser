# 이 파일은 없어도 됩니다.
# 동기화를 쓰지 않으면 앱은 이 PC 전용으로 그대로 동작합니다.
#
# 동기화를 쓰려면 보통 앱 안에서 넣는 쪽이 편합니다:
#   설정 → 계정 → Supabase 연결 (프로젝트 URL + anon 키)
# 여기에 넣어도 되고, 앱 설정값이 있으면 그쪽이 우선합니다.
#
# 내 Supabase 프로젝트 만드는 법은 README 의 "내 Supabase 만들기" 또는
# docs/supabase-설정.md 를 참고하세요.
# service_role 키는 절대 넣지 않는다 — anon(publishable) 키만 쓴다
SAMBA_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SAMBA_SUPABASE_ANON_KEY=sb_publishable_...

# (배포자용) 계정 디렉터리 — "로그인 먼저, 설정은 계정에 따라온다".
# 여기에 중앙 프로젝트 주소를 넣고 빌드하면 사용자는 로그인만 하면 되고,
# 자기 데이터 Supabase 주소는 계정에 저장돼 다른 PC 에서 자동으로 따라온다.
# 중앙 프로젝트에는 supabase/schema.sql 과 supabase/directory.sql 을 적용한다.
# 비워 두면 디렉터리 없이 위 데이터 프로젝트에 바로 로그인한다.
SAMBA_DIRECTORY_URL=
SAMBA_DIRECTORY_ANON_KEY=
